# === API Keys (KHONG BAO GIO commit file .env that len Git) ===

# Lay tai: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_claude_api_key_here

# Lay tai: https://aistudio.google.com/apikey  (dung cho Gemini / Nano Banana image gen)
GOOGLE_API_KEY=your_google_api_key_here

# Lay tai: https://platform.openai.com/api-keys  (dung cho GPT Image 2 / 2.5)
OPENAI_API_KEY=your_openai_api_key_here

# API CHINH CHU cua Kling AI. Dang ky tai: https://app.klingai.com/global/dev
# Vao muc "API Keys" -> tao key moi -> se hien Access Key va Secret Key (Secret chi hien 1 lan, luu ngay)
KLING_ACCESS_KEY=your_kling_access_key_here
KLING_SECRET_KEY=your_kling_secret_key_here

# (Tuy chon) Dung cho Seedream 5.0 Pro (qua fal.ai) va du phong cho cac nha cung cap video khac ngoai Kling
# Neu khong dien, cac muc nay se bao loi chua cau hinh - Kling video + Gemini/OpenAI image van chay binh thuong.
FAL_KEY=your_fal_api_key_here

# Neu ban xac dinh ro "Speed.2" la dich vu nao, dien key o day
SPEED2_API_KEY=your_speed2_api_key_here
SPEED2_BASE_URL=https://api.speed2.example.com

# Cau hinh server
PORT=3000

# Gioi han so request/gio cho moi IP (chong lam dung, ton chi phi API)
RATE_LIMIT_MAX=30
